# Copy to .env for local development (`make setup`). Never commit .env.
# NOTE: keep comments on their own lines; the Makefile also loads this file.

# development | production (production => JSON logs, ALLOWED_ORIGINS required)
APP_ENV=development
# Railway sets PORT itself; HTTP_ADDR overrides it if set.
PORT=8080

# Required
DATABASE_URL=postgres://arafa:arafa@localhost:5435/arafa360?sslmode=disable
REDIS_URL=redis://localhost:6381/0

# PostgreSQL pool. Railway Postgres allows ~100 connections TOTAL:
# DB_MAX_CONNS x replicas must stay below that.
DB_MAX_CONNS=25
DB_MIN_CONNS=5
AUTO_MIGRATE=true

# Goroutine pool for async side effects (defaults: 16 x CPUs workers, 20k queue)
# WORKER_POOL_SIZE=256
# WORKER_QUEUE_SIZE=20000

# WebSocket connection cap per replica
WS_MAX_CONNS=10000
# Comma-separated browser origins for CORS + WebSocket origin check
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Sentry (empty DSN = disabled). Use 0.05-0.2 sample rate in production.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_DEBUG=false

HTTP_ACCESS_LOG=true
